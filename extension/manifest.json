{
  "manifest_version": 3,
  "name": "NIFTY Chain LTP Overlay",
  "version": "0.7.0",
  "description": "NIFTY options chain controls and LTP labels for TradingView.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "action": {
    "default_title": "NIFTY Options",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://tradingview.com/*", "https://www.tradingview.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
